{
  "name": "durable-dav-test",
  "main": "../../apps/api/src/index.ts",
  "compatibility_date": "2025-11-29",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "DAV_VOLUME", "class_name": "DavVolumeWorker" },
      { "name": "CRON_TASKS", "class_name": "CronTasksWorker" },
      // Password-verification offload. Must be bound here or every Basic-auth
      // integration test silently exercises only the local-derivation fallback
      // and the DO tier is untested end-to-end.
      { "name": "DAV_AUTH", "class_name": "CredentialVerifierDO" },
    ],
  },
  "migrations": [
    { "tag": "v1000000000", "new_sqlite_classes": ["DavVolumeWorker", "CronTasksWorker"] },
    { "tag": "v1000000001", "new_sqlite_classes": ["CredentialVerifierDO"] },
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "durable-dav-test-db", "database_id": "00000000-0000-0000-0000-000000000000" }],
  // Without this the KV read cache is inert in integration tests — `KvCache`
  // reports `available: false` and every read falls through to the DO — so
  // cache-key and cache-poisoning bugs are invisible to this suite entirely.
  // `vitest-pool-workers` provides a local KV implementation for the namespace.
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],
  "vars": {
    "ENVIRONMENT": "development",
    "DEV_AUTH_EMAIL": "test@example.com",
    "SITE_URL": "https://example.com",
    // Deliberately small so a single PUT can exceed the *device* budget and
    // exercise dofs' ENOSPC path. It sits under `MAX_FILE_BYTES` (50 MB) so the
    // request reaches the filesystem instead of being refused by the per-file cap
    // first. The production default is 5 GB, which no test could reach.
    "DO_DEVICE_BYTES": "4194304",
  },
}
