{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "durable-dav",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2025-11-29",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": false,
  "minify": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "routes": [],
  "placement": {
    "mode": "off",
  },
  "assets": {
    "directory": "./apps/web/dist/",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAV_VOLUME",
        "class_name": "DavVolumeWorker",
      },
      {
        "name": "CRON_TASKS",
        "class_name": "CronTasksWorker",
      },
      // Password-verification offload. A Worker on the Free plan has a 10 ms
      // CPU budget, and one PBKDF2 derivation at 100k iterations costs more
      // than that, so verifying in the Worker made Cloudflare answer every
      // Basic-auth request with 503 (`outcome: "exceededCpu"`). A DO gets 30 s
      // regardless of plan. Internal only — never route to it from the open
      // internet; see CredentialVerifierDO.
      {
        "name": "DAV_AUTH",
        "class_name": "CredentialVerifierDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1000000000",
      "new_sqlite_classes": ["DavVolumeWorker", "CronTasksWorker"],
    },
    {
      // Added separately from v1000000000: that tag is already deployed, and a
      // DO class added to an applied tag is not registered. Existing tags are
      // immutable, so the new class needs its own.
      "tag": "v1000000001",
      "new_sqlite_classes": ["CredentialVerifierDO"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "durable-dav-db",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000",
    },
  ],
  "triggers": {
    // Unchanged by replication. The work is sliced, so replication shares the
    // existing 10-minute tick rather than needing a schedule of its own — which
    // also means `CronTasksWorker`'s per-cron single-flight map is untouched.
    "crons": ["*/10 * * * *"],
  },
  // No DEV_AUTH_EMAIL / DEMO_MODE here on purpose. Those are authentication
  // bypasses: with either set, every unauthenticated request authenticates as
  // that identity. They are guarded by `ENVIRONMENT !== "production"`, but
  // shipping a ready-made bypass identity inside the production template makes
  // a one-word edit (`ENVIRONMENT: "staging"`, or an `env.staging` block that
  // inherits `vars`) a full account takeover with no attacker effort. Set them
  // only in a non-production environment block, via a secret.
  "vars": {
    "ENVIRONMENT": "production",
    "DEBUG_MODE": "false",
    "SITE_URL": "",
    "POLICY_AUD": "",
    "TEAM_DOMAIN": "",
    "MAX_VOLUMES_PER_USER": "100",
    "MAX_CREDENTIALS_PER_VOLUME": "10",
    "DEFAULT_CREDENTIAL_EXPIRY_DAYS": "365",
    "MAX_CREDENTIAL_EXPIRY_DAYS": "365",
    "MAX_FILE_BYTES": "52428800",
    "DO_DEVICE_BYTES": "5368709120",
    // Scales the `davProp` (PROPFIND) and `davFile` (small GET body) TTLs
    // together; see `contentTtls` in DavReadCache. This is garbage collection,
    // not a correctness mechanism — every content-mutating DAV method still
    // purges on write, so a long TTL cannot serve stale bytes on its own.
    //
    // It was 300s, which sat *below* the poll interval of most WebDAV clients
    // (Finder/Cyberduck/rsync-style syncs run every few minutes), so they missed
    // the entry every single time and rewrote it on every request. Since the
    // free plan meters 1,000 writes/day against 100,000 reads/day, a
    // read-through cache needs a far higher hit ratio than that to pay for
    // itself. 24h turns a recurring traversal into cache hits. `davMeta` is
    // unaffected: the dashboard list has its own fixed 60s TTL.
    //
    // Ceiling to watch: the free plan also caps the namespace at 1GB, and
    // `davFile` stores up to ~933KB per entry (700KB raw, base64), so a
    // large enough file set can fill the namespace. `KvCache.putText` treats
    // an over-quota write as a soft miss, so it degrades rather than erroring.
    "DAV_CACHE_TTL_SECONDS": "86400",
    // --- Scheduled replication -------------------------------------------
    // Every budget below exists because `CronTasksWorker` runs all tasks in one
    // Durable Object invocation, and a two-way sync of a large bucket does not
    // fit in it. A tick visits at most SLICE_PATHS collections, moves at most
    // SLICE_BYTES, and spends at most SLICE_MS; it parks its cursor in D1 and
    // the next tick continues.
    //
    // Raising SLICE_PATHS without raising SLICE_MS is the change that turns a
    // slow sync into a timed-out one, which looks identical to a broken target.
    "MAX_REPLICATIONS_PER_VOLUME": "10",
    "REPLICATION_SWEEP_LIMIT": "10",
    "REPLICATION_SLICE_PATHS": "200",
    "REPLICATION_SLICE_BYTES": "33554432",
    "REPLICATION_SLICE_MS": "20000",
    // Bounds how long a pass may stay open. Not a performance knob: it is the
    // deletion gate's staleness bound. A pass wedged on one erroring path would
    // otherwise defer every deletion in the tree forever with nothing to report.
    "REPLICATION_PASS_MAX_MS": "600000",
    "MAX_REPLICATION_FAILURES": "5",
    "REPLICATION_TIMEOUT_MS": "30000",
    // Hash both sides when their validators disagree but their sizes match. Off
    // by default: it costs two full reads per ambiguous file, and the cheaper
    // alternative it guards against — assuming equal size means equal content —
    // silently drops one side's edit.
    "REPLICATION_HASH_ON_AMBIGUOUS": "false",
    // Comma-separated hosts exempt from the egress policy, which otherwise
    // refuses loopback, link-local, and RFC 1918 targets. Empty by default.
    //
    // This is a widening of the SSRF boundary and `AppConfiguration.validate()`
    // warns when it is set in production. It exists because the most common
    // replication target in practice is a self-hosted server on a private
    // network, and a policy with no way to permit it would make the feature
    // unusable exactly where it is wanted. Note it does not help a target that
    // is a sibling bucket — those go through `DavVolumeRemote`, which never
    // touches the network.
    //
    // REPLICATION_ENCRYPTION_KEY is a *secret*, not a var, and so is absent here
    // on purpose. It is required to store a remote target's credential: the
    // Worker must present that password on every sync, so unlike a bucket
    // credential it cannot be a one-way hash. Generate with
    // `generateReplicationKey()` and `wrangler secret put REPLICATION_ENCRYPTION_KEY`.
    "REPLICATION_ALLOWED_HOSTS": "",
  },
}
